<?xml version="1.0" encoding="UTF-8"?>

<?import bms.player.beatoraja.launcher.EditableTableView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fillWidth="true" spacing="8.0" xmlns="http://javafx.com/javafx/8.0.65"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bms.player.beatoraja.launcher.ResourceConfigurationView">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <HBox spacing="10.0">
        <Label prefWidth="90.0" text="%BMS_Path">
            <HBox.margin>
                <Insets top="8.0" />
            </HBox.margin>
        </Label>
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <ListView fx:id="bmsroot" onDragDropped="#songPathDragDropped"
                      onDragOver="#onSongPathDragOver" prefHeight="126.0"
                      VBox.vgrow="ALWAYS" />
            <Label style="-fx-text-fill: -fx-mid-text-color; -fx-font-size: 11px;"
                   text="%BMS_PATH_CONTEXT_HINT" wrapText="true" />
        </VBox>
        <VBox prefWidth="155.0" spacing="7.0">
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#addSongPath" prefHeight="31.0" text="%ADD_SONG_PATH" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#markAsDownloadDirectory" prefHeight="31.0"
                    text="%MARK_AS_DOWNLOAD_DIRECTORY">
                <tooltip><Tooltip text="%MARK_AS_DOWNLOAD_DIRECTORY_HINT" /></tooltip>
            </Button>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#createTestPlayPath" prefHeight="31.0"
                    text="%BMS_PATH_WORK_FOLDER">
                <tooltip><Tooltip text="%BMS_PATH_WORK_FOLDER_HINT" /></tooltip>
            </Button>
        </VBox>
    </HBox>

    <Separator />

    <HBox spacing="10.0" VBox.vgrow="ALWAYS">
        <Label prefWidth="90.0" text="%Table_URL">
            <HBox.margin>
                <Insets top="8.0" />
            </HBox.margin>
        </Label>
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <EditableTableView fx:id="tableurl" prefHeight="230.0"
                               VBox.vgrow="ALWAYS" />
            <Label style="-fx-text-fill: -fx-mid-text-color; -fx-font-size: 11px;"
                   text="%TABLE_CONTEXT_HINT" wrapText="true" />
        </VBox>
        <VBox prefWidth="175.0" spacing="7.0">
            <Region VBox.vgrow="ALWAYS" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#showAvailableTables" prefHeight="31.0"
                    text="%CHOOSE_EXISTING_TABLES" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#showAddTableUrlDialog" prefHeight="31.0"
                    text="%ADD_TABLE_FROM_URL" />
        </VBox>
    </HBox>

    <Separator />

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <VBox spacing="7.0">
            <CheckBox fx:id="updatesong" mnemonicParsing="false" text="%UPDATE_SONG" />
            <CheckBox fx:id="scanSongArchives" mnemonicParsing="false"
                      text="%SCAN_SONG_ARCHIVES" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <VBox prefWidth="310.0" spacing="3.0">
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#loadDiffBMS" prefHeight="28.0" text="%UPDATE_DATABASE" />
            <Label maxWidth="310.0" text="%UPDATE_DATABASE_DESCRIPTION" wrapText="true" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#loadAllBMS" prefHeight="28.0" text="%REBUILD_DATABASE">
                <VBox.margin>
                    <Insets top="3.0" />
                </VBox.margin>
            </Button>
            <Label maxWidth="310.0" text="%REBUILD_DATABASE_DESCRIPTION" wrapText="true" />
        </VBox>
    </HBox>
</VBox>
