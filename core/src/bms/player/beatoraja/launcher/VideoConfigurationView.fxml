<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.Spinner?>
<?import bms.player.beatoraja.launcher.NumericSpinner?>

<?import java.lang.String?>

<?import javafx.scene.layout.GridPane?>
<?import javafx.collections.FXCollections?>
<?import java.net.URL?>
<?import javafx.scene.control.ScrollPane?>
<ScrollPane xmlns="http://javafx.com/javafx/8.0.65" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bms.player.beatoraja.launcher.VideoConfigurationView">
    <GridPane styleClass="optionGrid">
        <Label text="%DISPLAY" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="2" styleClass="optionHeader"/>

        <Label text="%DISPLAYMODE" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <ComboBox fx:id="displayMode" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="%RESOLUTION" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <ComboBox fx:id="resolution" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="%MONITOR" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <ComboBox fx:id="monitor" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="%VSYNC" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <CheckBox fx:id="vSync" mnemonicParsing="false" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="%MAXFPS" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <NumericSpinner fx:id="maxFps" editable="true" GridPane.rowIndex="5" GridPane.columnIndex="1">
            <valueFactory>
                <SpinnerValueFactory.IntegerSpinnerValueFactory amountToStepBy="1" initialValue="60" max="1000" min="0"/>
            </valueFactory>
        </NumericSpinner>

        <Label text="%BGA" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.columnSpan="2" styleClass="optionHeader"/>

        <Label text="%BGA" GridPane.rowIndex="7" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <ComboBox fx:id="bgaOp" GridPane.rowIndex="7" GridPane.columnIndex="1">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="On"/>
                    <String fx:value="Auto"/>
                    <String fx:value="Off"/>
                </FXCollections>
            </items>
        </ComboBox>

        <Label text="%MISSLAYER_DURATION" GridPane.rowIndex="8" GridPane.columnIndex="0" styleClass="optionLabel">
            <tooltip>
                <Tooltip text="Set miss layer display time (ms)" textAlignment="CENTER"/>
            </tooltip>
        </Label>
        <NumericSpinner fx:id="missLayerTime" editable="true" GridPane.rowIndex="8" GridPane.columnIndex="1">
            <valueFactory>
                <SpinnerValueFactory.IntegerSpinnerValueFactory amountToStepBy="1" initialValue="500" max="10000" min="0"/>
            </valueFactory>
        </NumericSpinner>

        <Label text="%BGA_EXPAND" GridPane.rowIndex="9" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <ComboBox fx:id="bgaExpand" GridPane.rowIndex="9" GridPane.columnIndex="1">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Full"/>
                    <String fx:value="Keep Aspect Ratio"/>
                    <String fx:value="Off"/>
                </FXCollections>
            </items>
        </ComboBox>

        <Label text="%BGA_QUALITY" GridPane.rowIndex="10" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <ComboBox fx:id="bgaQuality" GridPane.rowIndex="10" GridPane.columnIndex="1"/>
        <Label text="%BGA_ASYNC_PIPELINE" GridPane.rowIndex="11" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <CheckBox fx:id="bgaAsyncPipeline" GridPane.rowIndex="11" GridPane.columnIndex="1"/>
        <Label text="%BGA_PERFORMANCE_STATS" GridPane.rowIndex="12" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <CheckBox fx:id="bgaPerformanceStats" GridPane.rowIndex="12" GridPane.columnIndex="1"/>

        <Label text="%HAND_CAMERA" GridPane.rowIndex="13" GridPane.columnSpan="2" styleClass="optionHeader"/>
        <CheckBox fx:id="handCameraEnabled" GridPane.rowIndex="14" GridPane.columnIndex="1"/>
        <Label text="%HAND_CAMERA_ENABLED" labelFor="$handCameraEnabled" GridPane.rowIndex="14" styleClass="optionLabel"/>
        <ComboBox fx:id="handCameraDevice" editable="true" GridPane.rowIndex="15" GridPane.columnIndex="1" prefWidth="250"/>
        <Label text="%HAND_CAMERA_DEVICE" labelFor="$handCameraDevice" GridPane.rowIndex="15" styleClass="optionLabel"/>
        <Button fx:id="handCameraRefresh" text="%HAND_CAMERA_REFRESH" onAction="#refreshHandCameras" GridPane.rowIndex="16" GridPane.columnIndex="1"/>
        <Label fx:id="handCameraStatus" text="%HAND_CAMERA_HELP" wrapText="true" maxWidth="400" GridPane.rowIndex="17" GridPane.columnSpan="2"/>
        <NumericSpinner fx:id="handCameraWidth" editable="true" GridPane.rowIndex="18" GridPane.columnIndex="1">
            <valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="640" min="160" max="1920"/></valueFactory>
        </NumericSpinner>
        <Label text="%HAND_CAMERA_WIDTH" labelFor="$handCameraWidth" GridPane.rowIndex="18" styleClass="optionLabel"/>
        <NumericSpinner fx:id="handCameraHeight" editable="true" GridPane.rowIndex="19" GridPane.columnIndex="1">
            <valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="480" min="120" max="1080"/></valueFactory>
        </NumericSpinner>
        <Label text="%HAND_CAMERA_HEIGHT" labelFor="$handCameraHeight" GridPane.rowIndex="19" styleClass="optionLabel"/>
        <NumericSpinner fx:id="handCameraFps" editable="true" GridPane.rowIndex="20" GridPane.columnIndex="1">
            <valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="30" min="1" max="60"/></valueFactory>
        </NumericSpinner>
        <Label text="%HAND_CAMERA_FPS" labelFor="$handCameraFps" GridPane.rowIndex="20" styleClass="optionLabel"/>
        <CheckBox fx:id="handCameraMirror" GridPane.rowIndex="21" GridPane.columnIndex="1"/>
        <Label text="%HAND_CAMERA_MIRROR" labelFor="$handCameraMirror" GridPane.rowIndex="21" styleClass="optionLabel"/>
        <CheckBox fx:id="handCameraBgaFrame" GridPane.rowIndex="22" GridPane.columnIndex="1"/>
        <Label text="%HAND_CAMERA_BGA_FRAME" labelFor="$handCameraBgaFrame" GridPane.rowIndex="22" styleClass="optionLabel"/>

        <stylesheets>
            <URL value="@LauncherStyle.css"/>
        </stylesheets>
    </GridPane>
</ScrollPane>
